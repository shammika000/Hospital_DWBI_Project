        "measures": [
          {
            "name": "Total Billing",
            "expression": [
              "",
              "SUM(FactFinanceBilling[TotalBill])"
            ]
          },
          {
            "name": "Billing Records",
            "expression": [
              "",
              "SUM(FactFinanceBilling[BillingCount])",
              ""
            ]
          },
          {
            "name": "Total Insurance Cover",
            "expression": [
              "",
              "SUM(FactFinanceBilling[InsuranceCover])"
            ]
          },
          {
            "name": "Total Final Payable",
            "expression": [
              "",
              "SUM(FactFinanceBilling[FinalAmountPayable])"
            ]
          },
          {
            "name": "Average Bill",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Billing],",
              "    [Billing Records],",
              "    0",
              ")"
            ]
          }
        ]
