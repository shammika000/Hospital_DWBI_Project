    CAST(Specialization AS NVARCHAR(100)) AS Specialization,

    CAST(NULL AS INT) AS YearsExperience,

    CAST(Consultation_Fee AS DECIMAL(14,2)) AS ConsultationFee,

    CAST(NULL AS NVARCHAR(100)) AS HospitalBranch

FROM dbo.stg_XLSX_Doctor s

