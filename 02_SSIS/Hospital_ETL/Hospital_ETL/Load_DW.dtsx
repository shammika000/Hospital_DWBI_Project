              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH AllDates AS
(
    SELECT CAST([Date] AS DATE) AS FullDate
    FROM dbo.stg_XLSX_Calendar

    UNION

    SELECT TRY_CONVERT(DATE, appointment_date)
    FROM dbo.stg_CSV_Appointment

    UNION

    SELECT TRY_CONVERT(DATE, treatment_date)
    FROM dbo.stg_CSV_Treatment

    UNION

    SELECT TRY_CONVERT(DATE, bill_date)
    FROM dbo.stg_CSV_Billing

    UNION

    SELECT CAST(Admission_Date AS DATE)
    FROM dbo.stg_XLSX_Admission

    UNION

    SELECT CAST(Discharge_Date AS DATE)
    FROM dbo.stg_XLSX_Admission
)

SELECT
    a.FullDate,

    YEAR(a.FullDate) * 10000
        + MONTH(a.FullDate) * 100
        + DAY(a.FullDate) AS DateKey,

    DAY(a.FullDate) AS DayNumber,

    MONTH(a.FullDate) AS MonthNumber,

    DATENAME(MONTH, a.FullDate) AS MonthName,

    DATEPART(QUARTER, a.FullDate) AS QuarterNumber,

    YEAR(a.FullDate) AS YearNumber

FROM AllDates a

WHERE a.FullDate IS NOT NULL

AND NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.DimDate d
    WHERE d.FullDate = a.FullDate
);</property>
                <property
