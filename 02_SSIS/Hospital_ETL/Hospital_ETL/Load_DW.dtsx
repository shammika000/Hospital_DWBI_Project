            <component
              refId="Package\DFT_Load_DimPatient\SRC_XLSX_Patients"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_XLSX_Patients"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('XLSX' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(Patient_ID AS NVARCHAR(50)) AS SourcePatientID,

    CAST(Patient_Name AS NVARCHAR(150)) AS PatientName,

    CAST(
        CASE
            WHEN UPPER(LTRIM(RTRIM(Gender))) IN ('M', 'MALE')
                THEN 'Male'

            WHEN UPPER(LTRIM(RTRIM(Gender))) IN ('F', 'FEMALE')
                THEN 'Female'

            ELSE LTRIM(RTRIM(Gender))
        END
        AS NVARCHAR(20)
    ) AS Gender,

    CAST(Date_of_Birth AS DATE) AS DateOfBirth,

    CAST(Phone AS NVARCHAR(50)) AS ContactNumber,

    CAST(City AS NVARCHAR(100)) AS City,

    CAST(NULL AS NVARCHAR(250)) AS Address,

    CAST(NULL AS NVARCHAR(100)) AS InsuranceProvider,

    CAST(Blood_Group AS NVARCHAR(10)) AS BloodGroup

FROM dbo.stg_XLSX_Patient s

WHERE NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.DimPatient d
    WHERE d.SourceSystemCode = 'XLSX'
      AND d.SourcePatientID =
          CAST(s.Patient_ID AS NVARCHAR(50))
);</property>
