              description="OLE DB Source"
              name="SRC_TreatmentTypes"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT TreatmentType
FROM
(
    SELECT
        CAST(
            UPPER(LTRIM(RTRIM(treatment_type)))
            AS NVARCHAR(100)
        ) AS TreatmentType
    FROM dbo.stg_CSV_Treatment

    UNION

    SELECT
        CAST(
            UPPER(LTRIM(RTRIM(Treatment_Type)))
            AS NVARCHAR(100)
        ) AS TreatmentType
    FROM dbo.stg_XLSX_Treatment
) AS CombinedTreatmentTypes

WHERE TreatmentType IS NOT NULL
  AND TreatmentType &lt;&gt; ''

  AND NOT EXISTS
  (
      SELECT 1
      FROM Hospital_DW.dbo.DimTreatmentType d
      WHERE d.TreatmentType =
            CombinedTreatmentTypes.TreatmentType
  );</property>
