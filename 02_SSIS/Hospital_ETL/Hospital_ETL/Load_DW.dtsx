            <component
              refId="Package\DFT_Load_FactTreatment\SRC_XLSX_Treatments"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_XLSX_Treatments"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('XLSX' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(t.Admission_ID AS NVARCHAR(50)) AS SourceEncounterID,

    CAST(t.Treatment_ID AS NVARCHAR(50)) AS SourceTreatmentID,

    CAST(a.Patient_ID AS NVARCHAR(50)) AS SourcePatientID,

    CAST(a.Doctor_ID AS NVARCHAR(50)) AS SourceDoctorID,

    CAST(d.Department_ID AS NVARCHAR(50)) AS SourceDepartmentID,

    CAST(
        UPPER(LTRIM(RTRIM(t.Treatment_Type)))
        AS NVARCHAR(100)
    ) AS StandardTreatmentType,

    CONVERT(
        INT,
        CONVERT(
            CHAR(8),
            CAST(a.Admission_Date AS DATE),
            112
        )
    ) AS EncounterDateKey,

    CAST(NULL AS INT) AS TreatmentDateKey,

    CAST(t.Treatment_Cost AS DECIMAL(14,2))
        AS TreatmentCost,

    CAST(t.Medicine_Cost AS DECIMAL(14,2))
        AS MedicineCost,

    CAST(t.Lab_Cost AS DECIMAL(14,2))
        AS LabCost,

    CAST(
          COALESCE(t.Treatment_Cost, 0)
        + COALESCE(t.Medicine_Cost, 0)
        + COALESCE(t.Lab_Cost, 0)
        AS DECIMAL(14,2)
    ) AS TotalTreatmentCost,

    CAST(1 AS INT) AS TreatmentCount

FROM dbo.stg_XLSX_Treatment t

INNER JOIN dbo.stg_XLSX_Admission a
    ON t.Admission_ID = a.Admission_ID

LEFT JOIN dbo.stg_XLSX_Doctor d
    ON a.Doctor_ID = d.Doctor_ID

WHERE NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.FactTreatment f

    INNER JOIN Hospital_DW.dbo.DimHospitalSource h
        ON f.HospitalSourceKey = h.HospitalSourceKey

    WHERE h.SourceSystemCode = 'XLSX'
      AND f.SourceTreatmentID =
          CAST(t.Treatment_ID AS NVARCHAR(50))
);</property>
