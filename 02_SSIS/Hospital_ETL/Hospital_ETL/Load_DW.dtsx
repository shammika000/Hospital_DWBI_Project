            <component
              refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_CSV_Treatments"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('CSV' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(t.appointment_id AS NVARCHAR(50)) AS SourceEncounterID,

    CAST(t.treatment_id AS NVARCHAR(50)) AS SourceTreatmentID,

    CAST(a.patient_id AS NVARCHAR(50)) AS SourcePatientID,

    CAST(a.doctor_id AS NVARCHAR(50)) AS SourceDoctorID,

    CAST(
        UPPER(LTRIM(RTRIM(t.treatment_type)))
        AS NVARCHAR(100)
    ) AS StandardTreatmentType,

    CONVERT(
        INT,
        CONVERT(
            CHAR(8),
            TRY_CONVERT(DATE, a.appointment_date),
            112
        )
    ) AS EncounterDateKey,

    CASE
        WHEN TRY_CONVERT(DATE, t.treatment_date) IS NULL
            THEN NULL
        ELSE CONVERT(
            INT,
            CONVERT(
                CHAR(8),
                TRY_CONVERT(DATE, t.treatment_date),
                112
            )
        )
    END AS TreatmentDateKey,

    TRY_CONVERT(DECIMAL(14,2), t.cost) AS TreatmentCost,

    CAST(NULL AS DECIMAL(14,2)) AS MedicineCost,

    CAST(NULL AS DECIMAL(14,2)) AS LabCost,

    TRY_CONVERT(DECIMAL(14,2), t.cost) AS TotalTreatmentCost,

    CAST(1 AS INT) AS TreatmentCount

FROM dbo.stg_CSV_Treatment t

INNER JOIN dbo.stg_CSV_Appointment a
    ON t.appointment_id = a.appointment_id

WHERE TRY_CONVERT(DATE, a.appointment_date) IS NOT NULL

AND NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.FactTreatment f

    INNER JOIN Hospital_DW.dbo.DimHospitalSource h
        ON f.HospitalSourceKey = h.HospitalSourceKey

    WHERE h.SourceSystemCode = 'CSV'
      AND f.SourceTreatmentID =
          CAST(t.treatment_id AS NVARCHAR(50))
);</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[OLEDB_Hospital_Staging]"
                  connectionManagerRefId="Package.ConnectionManagers[OLEDB_Hospital_Staging]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceSystemCode]"
                      codePage="1252"
                      dataType="str"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].ExternalColumns[SourceSystemCode]"
                      length="20"
                      lineageId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceSystemCode]"
                      name="SourceSystemCode"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceEncounterID]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].ExternalColumns[SourceEncounterID]"
                      length="50"
                      lineageId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceEncounterID]"
                      name="SourceEncounterID"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceTreatmentID]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].ExternalColumns[SourceTreatmentID]"
                      length="50"
                      lineageId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourceTreatmentID]"
                      name="SourceTreatmentID"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].Columns[SourcePatientID]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Load_FactTreatment\SRC_CSV_Treatments.Outputs[OLE DB Source Output].ExternalColumns[SourcePatientID]"
