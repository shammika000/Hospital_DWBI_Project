                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('CSV' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(doctor_id AS NVARCHAR(50)) AS SourceDoctorID,

    CAST(
        CONCAT(
            LTRIM(RTRIM(first_name)),
            ' ',
            LTRIM(RTRIM(last_name))
        )
        AS NVARCHAR(150)
    ) AS DoctorName,

    CAST(specialization AS NVARCHAR(100)) AS Specialization,

    TRY_CONVERT(INT, years_experience) AS YearsExperience,

    CAST(NULL AS DECIMAL(14,2)) AS ConsultationFee,

    CAST(hospital_branch AS NVARCHAR(100)) AS HospitalBranch

FROM dbo.stg_CSV_Doctor s

WHERE NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.DimDoctor d
    WHERE d.SourceSystemCode = 'CSV'
      AND d.SourceDoctorID =
          CAST(s.doctor_id AS NVARCHAR(50))
);</property>
