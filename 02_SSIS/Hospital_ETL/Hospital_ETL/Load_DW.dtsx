            <component
              refId="Package\DFT_Load_FactAppointment\SRC_CSV_Appointments"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_CSV_Appointments"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('CSV' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(appointment_id AS NVARCHAR(50)) AS SourceAppointmentID,

    CAST(patient_id AS NVARCHAR(50)) AS SourcePatientID,

    CAST(doctor_id AS NVARCHAR(50)) AS SourceDoctorID,

    TRY_CONVERT(DATE, appointment_date) AS AppointmentDate,

    CONVERT(
        INT,
        CONVERT(
            CHAR(8),
            TRY_CONVERT(DATE, appointment_date),
            112
        )
    ) AS AppointmentDateKey,

    CAST(appointment_time AS NVARCHAR(20)) AS AppointmentTime,

    CAST(reason_for_visit AS NVARCHAR(250)) AS ReasonForVisit,

    CAST(status AS NVARCHAR(50)) AS AppointmentStatus,

    CAST(1 AS INT) AS AppointmentCount

FROM dbo.stg_CSV_Appointment s

WHERE TRY_CONVERT(DATE, appointment_date) IS NOT NULL

AND NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.FactAppointment f
    INNER JOIN Hospital_DW.dbo.DimHospitalSource h
        ON f.HospitalSourceKey = h.HospitalSourceKey
    WHERE h.SourceSystemCode = 'CSV'
      AND f.SourceAppointmentID =
          CAST(s.appointment_id AS NVARCHAR(50))
);</property>
