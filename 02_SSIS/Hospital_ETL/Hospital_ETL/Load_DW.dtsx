            <component
              refId="Package\DFT_Load_FactBilling\SRC_XLSX_Billing"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_XLSX_Billing"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST('XLSX' AS VARCHAR(20)) AS SourceSystemCode,

    CAST(
        'ADM-' + CAST(b.Admission_ID AS NVARCHAR(40))
        AS NVARCHAR(50)
    ) AS SourceBillID,

    CAST(b.Admission_ID AS NVARCHAR(50))
        AS SourceEncounterID,

    CAST(a.Patient_ID AS NVARCHAR(50))
        AS SourcePatientID,

    CAST(a.Doctor_ID AS NVARCHAR(50))
        AS SourceDoctorID,

    CAST(d.Department_ID AS NVARCHAR(50))
        AS SourceDepartmentID,

    CONVERT(
        INT,
        CONVERT(
            CHAR(8),
            CAST(a.Admission_Date AS DATE),
            112
        )
    ) AS EncounterDateKey,

    CAST(NULL AS INT) AS BillingDateKey,

    CAST(
        UPPER(LTRIM(RTRIM(b.Payment_Mode)))
        AS NVARCHAR(50)
    ) AS PaymentMethod,

    CAST(
        UPPER(LTRIM(RTRIM(b.Payment_Status)))
        AS NVARCHAR(50)
    ) AS PaymentStatus,

    CAST(b.Total_Bill AS DECIMAL(14,2))
        AS TotalBill,

    CAST(b.Insurance_Cover AS DECIMAL(14,2))
        AS InsuranceCover,

    CAST(b.Final_Amount_Payable AS DECIMAL(14,2))
        AS FinalAmountPayable,

    TRY_CONVERT(INT, b.EMI_Months)
        AS EMIMonths,

    CAST(b.Monthly_EMI AS DECIMAL(14,2))
        AS MonthlyEMI,

    CAST(1 AS INT) AS BillingCount

FROM dbo.stg_XLSX_Billing b

INNER JOIN dbo.stg_XLSX_Admission a
    ON b.Admission_ID = a.Admission_ID

LEFT JOIN dbo.stg_XLSX_Doctor d
    ON a.Doctor_ID = d.Doctor_ID

WHERE NOT EXISTS
(
    SELECT 1
    FROM Hospital_DW.dbo.FactBilling f

    INNER JOIN Hospital_DW.dbo.DimHospitalSource h
        ON f.HospitalSourceKey = h.HospitalSourceKey

    WHERE h.SourceSystemCode = 'XLSX'
      AND f.SourceBillID =
          CAST(
              'ADM-' + CAST(b.Admission_ID AS NVARCHAR(40))
              AS NVARCHAR(50)
          )
);</property>
