    <DTS:Executable
      DTS:refId="Package\EST_Load_DimHospitalSource"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D9030504-0E5C-4404-BE6A-8F5C2DB2F492}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Load_DimHospitalSource"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D674A4CB-C519-4137-B403-E8453D6A7CD3}"
          SQLTask:SqlStatementSource="IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimHospitalSource&#xA;    WHERE SourceSystemCode = 'CSV'&#xA;)&#xA;BEGIN&#xA;    INSERT INTO dbo.DimHospitalSource&#xA;    (&#xA;        SourceSystemCode,&#xA;        SourceSystemName,&#xA;        SourceFormat&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        'CSV',&#xA;        'Hospital Source A',&#xA;        'CSV'&#xA;    );&#xA;END;&#xA;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimHospitalSource&#xA;    WHERE SourceSystemCode = 'XLSX'&#xA;)&#xA;BEGIN&#xA;    INSERT INTO dbo.DimHospitalSource&#xA;    (&#xA;        SourceSystemCode,&#xA;        SourceSystemName,&#xA;        SourceFormat&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        'XLSX',&#xA;        'Hospital Source B',&#xA;        'Excel'&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
