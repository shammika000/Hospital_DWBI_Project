      DTS:DTSID="{22738301-BDFB-43A4-9CED-7AA99B4E1A27}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Load_Finance_Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C23EB2C-EBA2-42A8-8A63-12CE7A84D38A}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.DimHospitalSource&#xA;(&#xA;    HospitalSourceKey,&#xA;    SourceSystemCode,&#xA;    SourceSystemName,&#xA;    SourceFormat&#xA;)&#xA;SELECT&#xA;    s.HospitalSourceKey,&#xA;    s.SourceSystemCode,&#xA;    s.SourceSystemName,&#xA;    s.SourceFormat&#xA;FROM Hospital_DW.dbo.DimHospitalSource s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimHospitalSource d&#xA;    WHERE d.HospitalSourceKey = s.HospitalSourceKey&#xA;);&#xA;&#xA;&#xA;INSERT INTO dbo.DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    DayNumber,&#xA;    MonthNumber,&#xA;    MonthName,&#xA;    QuarterNumber,&#xA;    YearNumber&#xA;)&#xA;SELECT&#xA;    s.DateKey,&#xA;    s.FullDate,&#xA;    s.DayNumber,&#xA;    s.MonthNumber,&#xA;    s.MonthName,&#xA;    s.QuarterNumber,&#xA;    s.YearNumber&#xA;FROM Hospital_DW.dbo.DimDate s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimDate d&#xA;    WHERE d.DateKey = s.DateKey&#xA;);&#xA;&#xA;&#xA;INSERT INTO dbo.DimPatientFinance&#xA;(&#xA;    PatientKey,&#xA;    Gender,&#xA;    City,&#xA;    InsuranceProvider&#xA;)&#xA;SELECT&#xA;    p.PatientKey,&#xA;    p.Gender,&#xA;    p.City,&#xA;    p.InsuranceProvider&#xA;FROM Hospital_DW.dbo.DimPatient p&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM Hospital_DW.dbo.FactBilling f&#xA;    WHERE f.PatientKey = p.PatientKey&#xA;)&#xA;AND NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimPatientFinance d&#xA;    WHERE d.PatientKey = p.PatientKey&#xA;);&#xA;&#xA;&#xA;INSERT INTO dbo.DimDoctorFinance&#xA;(&#xA;    DoctorKey,&#xA;    DoctorName,&#xA;    Specialization&#xA;)&#xA;SELECT&#xA;    d.DoctorKey,&#xA;    d.DoctorName,&#xA;    d.Specialization&#xA;FROM Hospital_DW.dbo.DimDoctor d&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM Hospital_DW.dbo.FactBilling f&#xA;    WHERE f.DoctorKey = d.DoctorKey&#xA;)&#xA;AND NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimDoctorFinance x&#xA;    WHERE x.DoctorKey = d.DoctorKey&#xA;);&#xA;&#xA;&#xA;INSERT INTO dbo.DimDepartmentFinance&#xA;(&#xA;    DepartmentKey,&#xA;    DepartmentName,&#xA;    FloorNumber&#xA;)&#xA;SELECT&#xA;    d.DepartmentKey,&#xA;    d.DepartmentName,&#xA;    d.FloorNumber&#xA;FROM Hospital_DW.dbo.DimDepartment d&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM Hospital_DW.dbo.FactBilling f&#xA;    WHERE f.DepartmentKey = d.DepartmentKey&#xA;)&#xA;AND NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimDepartmentFinance x&#xA;    WHERE x.DepartmentKey = d.DepartmentKey&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Load_Finance_Fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{50BEF0F9-3074-4C08-BC51-8872D8382BDF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Load_Finance_Fact"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9C23EB2C-EBA2-42A8-8A63-12CE7A84D38A}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.FactFinanceBilling&#xA;(&#xA;    BillingFactKey,&#xA;    HospitalSourceKey,&#xA;    PatientKey,&#xA;    DoctorKey,&#xA;    DepartmentKey,&#xA;&#xA;    EncounterDateKey,&#xA;    BillingDateKey,&#xA;    ReportingDateKey,&#xA;&#xA;    SourceBillID,&#xA;&#xA;    PaymentMethod,&#xA;    PaymentStatus,&#xA;&#xA;    TotalBill,&#xA;    InsuranceCover,&#xA;    FinalAmountPayable,&#xA;&#xA;    EMIMonths,&#xA;    MonthlyEMI,&#xA;&#xA;    BillingCount&#xA;)&#xA;&#xA;SELECT&#xA;    f.BillingFactKey,&#xA;    f.HospitalSourceKey,&#xA;    f.PatientKey,&#xA;    f.DoctorKey,&#xA;    f.DepartmentKey,&#xA;&#xA;    f.EncounterDateKey,&#xA;    f.BillingDateKey,&#xA;&#xA;    COALESCE(&#xA;        f.BillingDateKey,&#xA;        f.EncounterDateKey&#xA;    ) AS ReportingDateKey,&#xA;&#xA;    f.SourceBillID,&#xA;&#xA;    f.PaymentMethod,&#xA;    f.PaymentStatus,&#xA;&#xA;    f.TotalBill,&#xA;    f.InsuranceCover,&#xA;    f.FinalAmountPayable,&#xA;&#xA;    f.EMIMonths,&#xA;    f.MonthlyEMI,&#xA;&#xA;    f.BillingCount&#xA;&#xA;FROM Hospital_DW.dbo.FactBilling f&#xA;&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.FactFinanceBilling dm&#xA;    WHERE dm.BillingFactKey = f.BillingFactKey&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
